{
    "name": "idlab/loggable",
    "description": "Allows you to log updates occurring on entities",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "evlyn-idlab",
            "email": "evlyn@idlab.ch"
        }
    ],
    "autoload": {
        "psr-4": {
            "Idlab\\Loggable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Idlab\\Loggable\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "symfony/security-bundle": "^6.1",
        "lexik/jwt-authentication-bundle": "^2.21"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "doctrine/doctrine-bundle": "^2.13",
        "phpunit/phpunit": "^9.6",
        "symfony/framework-bundle": "^6.0",
        "symfony/yaml": "^6.4",
        "doctrine/orm": "^2.20"
    }
}
